import { system } from "@minecraft/server";

const SENSOR_ID = "playersensor:player_sensor";
const ACTIVE_STATE = "playersensor:active";
const CHECK_EVERY_TICKS = 5;

function insideDetectionBox(player, block, face) {
  const p = block.location;
  const x = player.location.x, y = player.location.y, z = player.location.z;
  // Reproduce the original sensor's directional detection volume: a 3-block
  // horizontal lane, one block wide, with up to 6 blocks of vertical clearance.
  switch (face) {
    case "north": return x >= p.x && x <= p.x + 1 && z >= p.z - 3 && z < p.z && y >= p.y - 6 && y <= p.y + 6;
    case "south": return x >= p.x && x <= p.x + 1 && z > p.z && z <= p.z + 3 && y >= p.y - 6 && y <= p.y + 6;
    case "east": return z >= p.z && z <= p.z + 1 && x > p.x && x <= p.x + 3 && y >= p.y - 6 && y <= p.y + 6;
    case "west": return z >= p.z && z <= p.z + 1 && x >= p.x - 3 && x < p.x && y >= p.y - 6 && y <= p.y + 6;
    case "up": return x >= p.x && x <= p.x + 1 && z >= p.z && z <= p.z + 1 && y >= p.y - 6 && y <= p.y + 6;
    case "down": return x >= p.x && x <= p.x + 1 && z >= p.z && z <= p.z + 1 && y >= p.y - 6 && y <= p.y + 6;
    default: return false;
  }
}

const PlayerSensorComponent = {
  onTick({ block }) {
    try {
      if (!block || block.typeId !== SENSOR_ID) return;
      const face = block.permutation.getState("minecraft:block_face") ?? "up";
      const p = block.location;
      const candidates = block.dimension.getPlayers({
        location: { x: p.x + 0.5, y: p.y + 0.5, z: p.z + 0.5 },
        maxDistance: 8
      });
      const detected = candidates.some(player => insideDetectionBox(player, block, face));
      const active = block.permutation.getState(ACTIVE_STATE) === true;
      if (active !== detected) {
        block.setPermutation(block.permutation.withState(ACTIVE_STATE, detected));
      }
    } catch (error) {
      console.warn(`[PlayerSensor] Error: ${error}`);
    }
  }
};

system.beforeEvents.startup.subscribe(({ blockComponentRegistry }) => {
  blockComponentRegistry.registerCustomComponent("playersensor:detect_players", PlayerSensorComponent);
});
